TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# TYPE_TEXT uses xAI Grok chat completions. Preferred auth is Grok subscription OAuth:
#   uv run jev-ultrafast login
# TEXT_MODEL_API_KEY is an optional CI/dev fallback, not the recommended path.
# TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.x.ai/v1
TEXT_MODEL=grok-4.6
TEXT_MODEL_REASONING=none
# Chrome CDP for Browser Harness (HTTP DevTools endpoint, not a WebSocket URL):
# BU_CDP_URL=http://127.0.0.1:9242
